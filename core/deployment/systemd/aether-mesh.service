[Unit]
Description=AETHER-PQ BATMAN-adv Mesh Interface Setup
After=network-pre.target
Before=network.target aether-uav.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c "modprobe batman-adv && ip link set dev eth0 up && batctl if add eth0 && ip link set dev bat0 up && ip addr add 192.168.171.1/24 dev bat0 || true"
ExecStop=/bin/bash -c "ip link set dev bat0 down && batctl if del eth0 || true"

[Install]
WantedBy=multi-user.target
