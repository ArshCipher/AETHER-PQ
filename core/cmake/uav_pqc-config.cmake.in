@PACKAGE_INIT@

# uav_pqc-config.cmake — generated by InstallRules.cmake
# Consumed by: find_package(uav_pqc CONFIG REQUIRED)

include(CMakeFindDependencyMacro)

# Re-find the same system dependencies that uav_pqc was built against
find_dependency(OpenSSL 3.0 REQUIRED)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(LibOQS REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/uav_pqc-targets.cmake")
