prefix=@UAV_PQC_PC_PREFIX@
includedir=@UAV_PQC_PC_INCDIR@
libdir=@UAV_PQC_PC_LIBDIR@

Name: uav_pqc
Description: Post-Quantum Communication Architecture for Heterogeneous UAV Networks
